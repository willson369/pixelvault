# MySQL（本机已有 MySQL80，请改成你的账号密码）
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/pixelvault"

# Auth.js
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3000"

# 腾讯云 COS（S3 兼容，与鱼皮云图库同栈；先占位，填真实密钥后再测上传）
COS_SECRET_ID="YOUR_COS_SECRET_ID"
COS_SECRET_KEY="YOUR_COS_SECRET_KEY"
COS_REGION="ap-guangzhou"
COS_BUCKET="your-bucket-APPID"
COS_ENDPOINT="https://cos.ap-guangzhou.myqcloud.com"
# 公网访问前缀，一般：https://{bucket}.cos.{region}.myqcloud.com
COS_PUBLIC_BASE_URL="https://your-bucket-APPID.cos.ap-guangzhou.myqcloud.com"

# AI：默认免费 Mock（OPENAI_API_KEY 留空）
# 可选免费额度示例（需自行申请 KEY）：
# Groq: OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.1-8b-instant
# DeepSeek 有对话但无 embedding，向量仍会走本地 Mock
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""
OPENAI_EMBEDDING_MODEL=""
